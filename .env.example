# Copy to .env.local (local) and add the same names in Vercel. Never commit real values.

# Dodo Payments: test mode until you go live. Key from Dodo dashboard > Developer > API keys.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_LIFETIME_PRODUCT_ID=pdt_0Nra2h89ysfzLORCXihev
# Offered after the 25 one-time seats are taken. Leave empty to pause sales instead.
DODO_MONTHLY_PRODUCT_ID=

# Firebase Admin: project settings > Service accounts > Generate new private key. Paste the JSON on one line, or base64 of it.
FIREBASE_SERVICE_ACCOUNT=

# Optional
NEXT_PUBLIC_SITE_URL=http://localhost:3100
ICON_LIMIT_SALT=
